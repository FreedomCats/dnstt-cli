# Build
/build/
/dist/
*.exe
# go build ./cmd/dnstt-cli without -o puts the binary in the root.
/dnstt-cli
*.zip

# Configuration and secrets — never in the repository.
# A profile stores references to secrets, but a password can be written into it by mistake.
profiles.toml
secrets.json
# dnstt server keys: the public key identifies the server, the private key even more so.
*.pub
*.key

# Local environment
.idea/
.vscode/
*.log

# Claude Code session exports: working records, not project code.
/claude-sessions/

# Stage logs, working notes, scripts and logs of runs — local only (AGENTS.md).
/doc/local/
/doc/runs/
