# Сборка
/build/
/dist/
*.exe
# go build ./cmd/dnstt-cli без -o кладёт бинарь в корень.
/dnstt-cli
*.zip

# Конфигурация и секреты — никогда не в репозиторий.
# Профиль хранит ссылки на секреты, но по ошибке в него можно вписать и сам пароль.
profiles.toml
secrets.json
# Ключи сервера dnstt: открытый ключ выдаёт сервер, закрытый — тем более.
*.pub
*.key

# Локальное окружение
.idea/
.vscode/
*.log

# Выгрузки сессий Claude Code: рабочие записи, а не код проекта.
/claude-sessions/

# Журналы этапов, рабочие записки, скрипты и логи прогонов — локально (AGENTS.md).
/doc/local/
