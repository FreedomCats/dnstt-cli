# Sources are stored and checked out with LF: core/ must match the dnstt upstream
# byte for byte, otherwise the diff on a core update drowns in line endings.
* text=auto eol=lf

*.go       text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
.gitignore text eol=lf

LICENSE text eol=lf
